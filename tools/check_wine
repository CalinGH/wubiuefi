#!/bin/sh
#
# Create (if needed) the Wine environment used to freeze wubi.exe.
#
# Historically this script installed a 32-bit Python 2.7 inside Wine together
# with pywin32, pycrypto, ctypes, subprocess and the standalone "mock"
# package, and the application was frozen with the in-tree pypack/pylauncher
# freezer.
#
# The toolchain now targets Python 3.12 (32-bit) and freezes the application
# with PyInstaller. The official python.org installer cannot run under Wine
# (its WiX bootstrapper fails to create its UI window), so we install the
# self-contained NuGet "pythonx86" distribution instead, then bootstrap pip
# and install PyInstaller + pycryptodome (the maintained drop-in for the
# "Crypto" namespace used by the vendored openpgp library).
#
# The build still needs to remain 32-bit because the bundled cpuid.dll
# (src/cpuid) is 32-bit x86 code loaded via ctypes at runtime.

set -e

# 32-bit Python 3.12 (NuGet distribution: a plain zip with a full layout).
python_version="3.12.7"
python_nuget_url="https://globalcdn.nuget.org/packages/pythonx86.${python_version}.nupkg"
getpip_url="https://bootstrap.pypa.io/get-pip.py"

root="$(cd "${0%/*}/../";pwd)"
export WINEARCH="win32"
export WINEPREFIX="$root/wine"
export WINEDEBUG="${WINEDEBUG:--all}"
python_dir="$WINEPREFIX/drive_c/Python312"
python_exe="c:/Python312/python.exe"
python_site="$python_dir/Lib/site-packages"
dldir="$root/build/wine-downloads"
toolsdir="$root/tools"

mkdir -p "$dldir"

download() {
    # download <url> <destination>
    if [ ! -f "$2" ]; then
        echo "Downloading $1"
        wget -q -O "$2" "$1"
    fi
}

install_wine() {
    if ! command -v wine >/dev/null 2>&1; then
        echo "Installing wine..."
        sudo dpkg --add-architecture i386
        sudo apt-get update
        sudo apt-get install -y wine wine32:i386 wine64 #TBD do not assume apt
    fi
}

install_mingw() {
    # 32-bit MinGW cross compiler, needed to build src/cpuid/cpuid.dll.
    if ! command -v i686-w64-mingw32-gcc >/dev/null 2>&1; then
        echo "Installing mingw-w64 (i686)..."
        sudo apt-get install -y gcc-mingw-w64-i686 binutils-mingw-w64-i686 #TBD do not assume apt
    fi
}

install_unzip() {
    if ! command -v unzip >/dev/null 2>&1; then
        echo "Installing unzip..."
        sudo apt-get install -y unzip #TBD do not assume apt
    fi
}

create_wineprefix() {
    if [ ! -e "$WINEPREFIX/system.reg" ]; then
        echo "Creating Wine prefix in $WINEPREFIX..."
        wineboot -i
        wineserver -w
    fi
}

install_python() {
    echo "Installing Python $python_version (32-bit) into the Wine prefix..."
    nupkg="$dldir/pythonx86.${python_version}.nupkg"
    download "$python_nuget_url" "$nupkg"
    rm -rf "$dldir/pyextract"
    mkdir -p "$dldir/pyextract"
    unzip -q "$nupkg" -d "$dldir/pyextract"
    rm -rf "$python_dir"
    cp -a "$dldir/pyextract/tools" "$python_dir"
    # The NuGet build ships a python3x._pth that disables site imports; remove
    # it so that site-packages (and therefore pip-installed packages) load.
    rm -f "$python_dir"/python*._pth
    # Python 3.12's _wmi extension queries WMI via COM, which reaches
    # propsys.dll.VariantToString -- unimplemented in the Wine versions shipped
    # with Ubuntu, where the missing stub aborts the whole process (so it can't
    # be caught in Python). The standard library's platform module already
    # guards "import _wmi" with "except ImportError" and falls back to a
    # WMI-free path, so removing the extension lets pip and PyInstaller run.
    rm -f "$python_dir"/DLLs/_wmi.pyd
}

install_pip() {
    echo "Bootstrapping pip..."
    getpip="$dldir/get-pip.py"
    download "$getpip_url" "$getpip"
    wine "$python_exe" "$(winepath -w "$getpip")" --no-warn-script-location
}

install_build_deps() {
    echo "Installing PyInstaller and pycryptodome..."
    wine "$python_exe" -m pip install --no-warn-script-location \
        pyinstaller pycryptodome
}

install_mock() {
    # Provide the "mock" top-level module expected by the unit tests. On
    # Python 3 it simply re-exports unittest.mock (see data/unit-test/mock.py).
    echo "Installing mock shim for the unit tests..."
    mkdir -p "$python_site"
    cp "$root/data/unit-test/mock.py" "$python_site/mock.py"
}

install_wine
install_mingw
install_unzip
create_wineprefix

if [ ! -e "$python_dir/python.exe" ]; then
    install_python
fi
if [ ! -e "$python_site/pip" ]; then
    install_pip
fi
if [ ! -e "$python_site/PyInstaller" ] || [ ! -e "$python_site/Crypto" ]; then
    install_build_deps
fi
if [ ! -e "$python_site/mock.py" ]; then
    install_mock
fi
